declare
    cursor c1 is
        select id, name from studet;

    v_id studet.id%type;
    v_name studet.name%type;
begin
    open c1;

    loop
        fetch c1 into v_id, v_name;
        exit when c1%notfound;

        dbms_output.put_line(v_id || ' ' || v_name);
    end loop;

    close c1;
end;

