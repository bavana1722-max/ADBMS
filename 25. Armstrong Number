declare
    n number := :enter;
    temp number;
    rem number;
    result number := 0;
begin
    temp := n;

    while temp > 0 loop
        rem := mod(temp, 10);
        result := result + power(rem, 3);
        temp := trunc(temp / 10);
    end loop;

    if result = n then
        dbms_output.put_line('armstrong number');
    else
        dbms_output.put_line('not an armstrong number');
    end if;
end;
