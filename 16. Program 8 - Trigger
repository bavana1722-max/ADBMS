create or replace trigger tdel22 after update or delete on stu4
declare 
smsg varchar(20) := ' trigger fired :';
begin 
if updating then
dbms_output.put_line(smsg || ' record updated');
elsif deleting then
dbms_output.put_line(smsg || ' record deleted');
end if;
end;

